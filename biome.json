{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!.claude/skills"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**"],
                "message": "Импорт вверх по дереву — через алиас `~/` (ARCHITECTURE.md, «Правила импорта»)."
              }
            ]
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 120
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/logic/tasks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**"],
                    "message": "Импорт вверх по дереву — через алиас `~/` (ARCHITECTURE.md, «Правила импорта»)."
                  },
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "mobx-react-lite"
                    ],
                    "message": "Таски не зависят от React (ARCHITECTURE.md, «Таски»)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui-kit/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**"],
                    "message": "Импорт вверх по дереву — через алиас `~/` (ARCHITECTURE.md, «Правила импорта»)."
                  },
                  {
                    "group": [
                      "~/App",
                      "~/App/**",
                      "~/logic",
                      "~/logic/**",
                      "react-i18next"
                    ],
                    "message": "ui-kit не знает о предметной области, тексты получает через props (ARCHITECTURE.md, «Дерево»)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/index.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":BUN:"],
              ":BLANK_LINE:",
              ["react", "react/**", "react-dom", "react-dom/**"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!:STYLE:"],
              ":BLANK_LINE:",
              [":ALIAS:", "!:STYLE:"],
              ":BLANK_LINE:",
              [":PATH:", "!:STYLE:"],
              ":BLANK_LINE:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  }
}
